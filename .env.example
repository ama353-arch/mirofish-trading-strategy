# ── LLM Provider ──────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ── News API ──────────────────────────────────────────────
NEWS_API_KEY=your-newsapi-key

# ── Reddit API (for PRAW) ────────────────────────────────
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-secret
REDDIT_USER_AGENT=mirofish-trading/1.0

# ══════════════════════════════════════════════════════════
#  HISTORICAL DATA FETCHERS — READ-ONLY, for backtesting only
# ══════════════════════════════════════════════════════════
# These power the walk-forward backtest + calibration. They pull RESOLVED
# markets and price history. They must NEVER have order/trading scope.
#
#  RULES:
#   - Put real values in `.env` (gitignored), NOT here, NOT in chat.
#   - Use READ-ONLY / market-data scope. If your key can place orders,
#     create a separate read-only key for this — the engine never trades.
#   - Polymarket historical data (Gamma API / subgraph) needs NO key at all.

# ── Kalshi (read-only market data) ────────────────────────
# Kalshi's market-data endpoints work unauthenticated for recent data.
# For full settled history, a read-only API key helps with rate limits.
KALSHI_API_KEY_ID=your-read-only-key-id
KALSHI_API_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-readonly.pem
# DO NOT use a trading-enabled key here.

# ── Polymarket (read-only; no key required) ───────────────
# Resolved markets + trade history come from the public Gamma API and
# subgraph. No key needed. (A POLYMARKET_API_KEY is ONLY for trading and
# is intentionally NOT read by the backtest fetchers.)

# ── yfinance ──────────────────────────────────────────────
# No API key needed (uses Yahoo Finance public endpoints)
